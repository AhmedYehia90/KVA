generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PILOT
  DISPATCHER
  INSTRUCTOR
  FLEET_MANAGER
  ADMIN
}

enum FlightStatus {
  SCHEDULED
  BOARDING
  AIRBORNE
  LANDED
  CANCELLED
}

enum EventProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  role        UserRole @default(PILOT)
  ivaoVid     String?  @unique
  createdAt   DateTime @default(now())

  pilot Pilot?
}

model Pilot {
  id          String @id @default(cuid())
  userId      String @unique
  callsign    String @unique
  rank        String @default("Cadet")
  flightHours Float  @default(0)
  points      Int    @default(0)

  user   User    @relation(fields: [userId], references: [id])
  pireps Pirep[]
}

model Aircraft {
  id              String    @id @default(cuid())
  registration    String    @unique
  type            String
  status          String    @default("AVAILABLE")
  totalHours      Float     @default(0)
  nextMaintenance DateTime?

  flights Flight[]
}

model Route {
  id              String @id @default(cuid())
  flightNumber    String @unique
  originIcao      String
  destinationIcao String
  distanceNm      Int?

  flights Flight[]
}

model Flight {
  id          String       @id @default(cuid())
  routeId     String
  aircraftId  String?
  departureAt DateTime
  arrivalAt   DateTime
  status      FlightStatus @default(SCHEDULED)

  route    Route     @relation(fields: [routeId], references: [id])
  aircraft Aircraft? @relation(fields: [aircraftId], references: [id])
  pirep    Pirep?
}

model Pirep {
  id             String   @id @default(cuid())
  flightId       String   @unique
  pilotId        String
  simulator      String
  network        String?
  blockTimeMin   Int
  fuelUsedKg     Float?
  landingRateFpm Int?
  accepted       Boolean  @default(false)
  submittedAt    DateTime @default(now())

  flight Flight @relation(fields: [flightId], references: [id])
  pilot  Pilot  @relation(fields: [pilotId], references: [id])
}

model PlatformEvent {
  id              String   @id @default(uuid()) @db.Uuid
  eventType       String   @map("event_type")
  eventVersion    Int      @default(1) @map("event_version")
  organizationId  String?  @map("organization_id")
  aggregateType   String   @map("aggregate_type")
  aggregateId     String   @map("aggregate_id")
  actorId         String?  @map("actor_id")
  correlationId   String   @db.Uuid @map("correlation_id")
  causationId     String?  @db.Uuid @map("causation_id")
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  payload         Json
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  processingLogs  EventProcessingLog[]

  @@index([eventType, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([correlationId])
  @@map("platform_events")
}

model EventProcessingLog {
  id           String                @id @default(uuid()) @db.Uuid
  eventId      String                @db.Uuid @map("event_id")
  consumerName String                @map("consumer_name")
  status       EventProcessingStatus @default(PENDING)
  attempts     Int                   @default(0)
  lastError    String?               @map("last_error")
  processedAt  DateTime?             @map("processed_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  event        PlatformEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, consumerName])
  @@index([status, updatedAt])
  @@map("event_processing_log")
}
